# Optional. Default remote PostgreSQL URI for collaboration (any provider).
# Copy to `.env` and fill in. Never commit real credentials.
#
# Local / cargo tauri dev:
#   DATABASE_URL is read at runtime from this file (and can also be baked at
#   `cargo tauri build` time via build.rs).
#
# GitHub Actions releases:
#   - push to `dev`  → embeds secrets.DEV_DATABASE_URL
#   - merge to `main` → embeds secrets.PROD_DATABASE_URL
#   as the app default for setup login + navbar Connect.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
