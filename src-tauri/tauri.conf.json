{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ndimbelente",
  "version": "0.1.2",
  "identifier": "com.ndimbelente.app",
  "build": {
    "beforeDevCommand": "bun run css:build && bun run trunk:serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run css:build && bun run trunk:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ndimbelente",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
