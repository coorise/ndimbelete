{
  "name": "ndimbelente",
  "type": "module",
  "private": true,
  "scripts": {
    "css:build": "bunx @tailwindcss/cli -i ./src/styles/input.css -o ./styles.css --minify",
    "css:watch": "bunx @tailwindcss/cli -i ./src/styles/input.css -o ./styles.css --watch",
    "trunk:serve": "bun run scripts/trunk.mjs serve",
    "trunk:build": "bun run scripts/trunk.mjs build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
